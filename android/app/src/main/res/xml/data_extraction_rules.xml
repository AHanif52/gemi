<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: DB dan kunci tidak ikut cloud backup maupun device transfer (BRD: file DB diekstrak). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
